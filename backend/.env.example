# Server Configuration
PORT=8080
NODE_ENV=development

# Frontend URL (dùng redirect sau thanh toán VNPay)
BASE_URL_FRONTEND=http://localhost:5173

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=evo_market
DB_DIALECT=mysql
DB_PORT=3306

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_REFRESH_EXPIRE=7d

# Public URL của backend — không có /api-v1 (đăng ký Return URL & IPN trên cổng VNPay)
API_PUBLIC_BASE_URL=http://localhost:8080

# VNPay
VNPAY_TMN_CODE=your_tmn_code
VNPAY_HASH_SECRET=your_hash_secret
# Đặt false khi chạy production với host VNPay thật
VNPAY_TEST_MODE=true
VNPAY_ENABLE_LOG=true
VNPAY_HOST=https://vnpayment.vn

# Đơn hàng: tự động hoàn tất sau N ngày kể từ khi shop đánh dấu đã giao cho ĐVVC (mặc định 7)
ORDER_AUTO_COMPLETE_DAYS_AFTER_SHIPPED=7
